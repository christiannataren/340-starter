<%- messages() %>
    <% if (errors) { %>
        <ul class="error">
            <% errors.array().forEach(error=> { %>
                <li>
                    <%= error.msg %>
                </li>
                <% }) %>
        </ul>
        <% } %>
            <h2><%- title %></h2>
            <div id="add-classification-form">
                <form action="/inv/add-classification" method="post">
                    <label>
                        Classification Name <span class="required"></span>
                        <span id="pass-msg">(Name must be alphabetic characters only)</span>
                        <input type="text" name="classification_name" id="classification_name" pattern="[A-Za-z]+"
                            required placeholder="Insert a classification name">

                    </label>
                    <input type="submit" name="submit" id="submit" value="Add Classification">

                </form>
            </div>