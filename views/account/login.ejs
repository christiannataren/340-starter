<h2><%- title %></h2>
<%- messages() %>
    <% if (errors) { %>
        <ul class="error">
            <% errors.array().forEach(error=> { %>
                <li>
                    <%= error.msg %>
                </li>
                <% }) %>
        </ul>
        <% } %>
            <div id="login_form">

                <form id="loginForm" action="/account/login" method="post">
                    <h3>Welcome</h3>
                    <label>
                        Email:
                        <input type="email" required name="account_email" id="account_email"
                            placeholder="Enter a valid email address">
                    </label>
                    <label>
                        Password:
                        <span id="pass-msg">(Passwords must be at least 12 characters and contain at least 1 number, 1
                            capital
                            letter and 1
                            special character)</span>
                        <input type="password"
                            pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$" required
                            name="account_password" id="account_password">
                    </label>
                    <input type="submit" name="submit" id="submit" value="Login">
                    <div id="register_menu"><span>No Account? </span><a href="/account/register">Sign-up</a></div>
                </form>


            </div>