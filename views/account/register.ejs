<%- messages() %>
    <% if (errors) { %>
        <ul class="error">
            <% errors.array().forEach(error=> { %>
                <li>
                    <%= error.msg %>
                </li>
                <% }) %>
        </ul>
        <% } %>
            <div id="login_form">
                <form action="/account/register" method="post">
                    <h2><%- title %></h2>

                    <label>
                        First name<span class="required"></span>
                        <input type="text" required name="account_firstname" id="account_firstname"
                            value='<%= locals.account_firstname %>'>
                    </label>
                    <label>
                        Last name<span class="required"></span>
                        <input type="text" required name="account_lastname" id="account_lastname"
                            value='<%= locals.account_lastname %>'>
                    </label>
                    <label>
                        Email address<span class="required"></span>
                        <input type="email" required name="account_email" id="account_email"
                            placeholder="Enter a valid email address" value='<%= locals.account_email %>'>
                    </label>
                    <div id="password-lbl">
                        <button id="see-password" type="button" data-action=""></button>
                        <label>

                            Password<span class="required"></span>
                            <span id="pass-msg">(Passwords must be at least 12 characters and contain at least 1 number,
                                1
                                capital
                                letter and 1
                                special character)</span>
                            <input type="password"
                                pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$" required
                                name="account_password" id="account_password">

                        </label>
                    </div>

                    <input type="submit" class="register-btn" name="submit" id="submit" value="Register">

                </form>


            </div>